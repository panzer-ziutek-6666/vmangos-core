@@ -0,0 +1,54 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { loadConfig } from '../server/config.js';
+
+const MYSQL = Object.freeze({
+  host: '127.0.0.1', port: 3306, user: 'offline_fixture_user',
+  password: 'offline_fixture_password', database: 'realmd_dev'
+});
+
+function minimal() {
+  return { panel: { port: 8420 }, mysql: { logon: { ...MYSQL } } };
+}
+
+test('WOW-SRV config: readOnly accepts no SOAP section or credentials', () => {
+  const config = loadConfig(minimal(), { readOnly: true });
+  assert.equal(config.soap, null);
+  assert.equal(config.mysql.logon.database, 'realmd_dev');
+  assert.equal(config.panel.port, 8420);
+  assert.ok(Object.isFrozen(config));
+});
+
+test('WOW-SRV config: readOnly discards any supplied SOAP credentials', () => {
+  const raw = minimal();
+  raw.soap = { host: 'not-used', port: 9, user: 'forbidden-user', pass: 'forbidden-secret' };
+  const config = loadConfig(raw, { readOnly: true });
+  assert.equal(config.soap, null);
+  assert.ok(!JSON.stringify(config).includes('forbidden-secret'));
+});
+
+test('WOW-SRV config: ordinary mode still requires a SOAP section', () => {
+  assert.throws(() => loadConfig(minimal()), /missing section "soap"/);
+});
+
+test('WOW-SRV config: ordinary mode still requires SOAP user and password', () => {
+  const raw = minimal();
+  raw.soap = { host: '127.0.0.1', port: 7878, user: 'operator' };
+  assert.throws(() => loadConfig(raw), /soap.pass is required/);
+  raw.soap.pass = 'fixture-only';
+  delete raw.soap.user;
+  assert.throws(() => loadConfig(raw), /soap.user is required/);
+});
+
+test('WOW-SRV config: existing full SOAP configuration remains valid in ordinary mode', () => {
+  const raw = minimal();
+  raw.soap = { host: '127.0.0.1', port: 7878, user: 'operator', pass: 'fixture-only' };
+  const config = loadConfig(raw);
+  assert.equal(config.soap.user, 'operator');
+  assert.equal(config.soap.port, 7878);
+});
+
+test('WOW-SRV config: readOnly option is strictly boolean', () => {
+  assert.throws(() => loadConfig(minimal(), { readOnly: 'true' }), /readOnly must be a boolean/);
+  assert.throws(() => loadConfig(minimal(), { readOnly: 1 }), /readOnly must be a boolean/);
+});
﻿diff --git a/test/wow-srv-readonly.test.js b/test/wow-srv-readonly.test.js
new file mode 100644
index 0000000..954749c
--- /dev/null
+++ b/test/wow-srv-readonly.test.js
@@ -0,0 +1,85 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { buildApp } from '../server/app.js';
+import { createDisabledSoapClient, createReadOnlyAudit } from '../server/wow-srv-readonly.js';
+import { CONFIG, HEADERS } from './helpers/dbApp.js';
+
+function fixture() {
+  let sqlCalls = 0;
+  const pools = {
+    logon: { query: async () => { sqlCalls += 1; return [[]]; } },
+    world: { query: async () => { sqlCalls += 1; return [[]]; } },
+    characters: { query: async () => { sqlCalls += 1; return [[]]; } }
+  };
+  const app = buildApp({
+    config: CONFIG,
+    soap: createDisabledSoapClient(),
+    audit: createReadOnlyAudit(),
+    pools,
+    readOnly: true
+  });
+  return { app, sqlCalls: () => sqlCalls };
+}
+
+test('WOW-SRV: all write methods and privileged endpoints are rejected before handlers', async (t) => {
+  const { app, sqlCalls } = fixture();
+  t.after(() => app.close());
+  for (const url of [
+    '/accounts/create', '/accounts/delete', '/server/announce', '/server/shutdown',
+    '/characters/erase', '/events/start', '/tickets/reset',
+    '/realms/create', '/realms/1/update', '/realms/1/delete'
+  ]) {
+    const result = await app.inject({ method: 'POST', url, headers: HEADERS, payload: {} });
+    assert.equal(result.statusCode, 405, `route ${url} not blocked`);
+    assert.equal(result.headers.allow, 'GET, HEAD');
+  }
+  for (const method of ['PUT', 'PATCH', 'DELETE', 'OPTIONS']) {
+    const result = await app.inject({ method, url: '/realms/1/delete', headers: HEADERS });
+    assert.equal(result.statusCode, 405, `${method} not blocked`);
+  }
+  assert.equal(sqlCalls(), 0, 'no SQL must run for rejected mutations');
+});
+
+test('WOW-SRV: disabled SOAP never performs a network call and reports offline', async () => {
+  const soap = createDisabledSoapClient();
+  const result = await soap.execute('.server info');
+  assert.equal(result.ok, false);
+  assert.equal(result.status, 'disabled');
+  assert.equal(soap.queueDepth(), 0);
+});
+
+test('WOW-SRV: GET /status and /events override a supplied live SOAP executor', async (t) => {
+  let unexpectedSoapCalls = 0;
+  const suppliedSoap = {
+    execute: async () => { unexpectedSoapCalls += 1; throw new Error('LIVE SOAP MUST NOT RUN'); },
+    queueDepth: () => 0
+  };
+  const pools = {
+    logon: { query: async () => [[]] },
+    world: { query: async () => [[]] }
+  };
+  const app = buildApp({
+    config: CONFIG, soap: suppliedSoap, audit: createReadOnlyAudit(),
+    pools, readOnly: true
+  });
+  t.after(() => app.close());
+  const status = await app.inject({ method: 'GET', url: '/status', headers: HEADERS });
+  assert.equal(status.statusCode, 200);
+  const events = await app.inject({ method: 'GET', url: '/events', headers: HEADERS });
+  assert.equal(events.statusCode, 200);
+  assert.equal(unexpectedSoapCalls, 0);
+});
+
+test('WOW-SRV: read-only audit cannot accept action records', () => {
+  const audit = createReadOnlyAudit();
+  assert.deepEqual(audit.recent(100), []);
+  assert.throws(() => audit.record({ command: '.server shutdown 1' }), /disabled/);
+});
+
+test('WOW-SRV: GET /status is served without real SOAP', async (t) => {
+  const { app } = fixture();
+  t.after(() => app.close());
+  const result = await app.inject({ method: 'GET', url: '/status', headers: HEADERS });
+  assert.equal(result.statusCode, 200);
+  assert.match(result.body, /SOAP is disabled/);
+});
